[Unit]
Description=DLM Warehouse FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dlm-backend
EnvironmentFile=/opt/dlm-backend/.env
ExecStart=/opt/dlm-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
